<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFF3DCB" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#66FF3DCB" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24FF3DCB" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#33FF3DCB" />
        </shape>
    </item>
</selector>
