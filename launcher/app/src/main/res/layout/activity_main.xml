<?xml version="1.0" encoding="utf-8"?>
<!-- Manga Ink (dark): ink-lined panels on near-black screentone paper. The wallpaper sits in the big
     panel, with its name; the clock, weather and next prayer in cards beside it; the top bar above;
     the dock and the rest of the apps below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/paper">

    <!-- Ambient glow in the colour of the focused app: off in this look (AMBIENT_ALPHA). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Former full-screen fades; the paper needs none (config.xml hud_grid). -->
    <View
        android:id="@+id/hudGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- The old verse and prayer-table shelf: kept for the code that fills it, never shown in the Manga Ink
         layout (the prayer card shows the next prayer; the verse is in Settings → Daily verse). -->
    <LinearLayout
        android:id="@+id/islamicShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone"
        android:alpha="0">

        <!-- Ayat / Doa Harian (WeeklyAyah) matching bravia-glass-tv UI -->
        <LinearLayout
            android:id="@+id/ayahBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <TextView
                android:id="@+id/ayahLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY VERSE"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/hud"
                android:fontVariationSettings="'wght' 600"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ayahArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="460dp"
                android:gravity="end"
                android:textDirection="rtl"
                android:textColor="#FFFFC56B"
                android:textSize="20sp"
                android:fontFamily="@font/amiri_quran"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/ayahText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="460dp"
                android:gravity="end"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/hud"
                android:fontVariationSettings="'wght' 400"
                android:lineSpacingExtra="1.5dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>

        <!-- Waktu Solat Header (e.g. WAKTU SOLAT • 11 JAMADILAWAL 1448H) -->
        <TextView
            android:id="@+id/prayerHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/hud"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.14"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- Waktu Solat Table (6 Columns: Subuh, Syuruk, Zohor, Asar, Maghrib, Isyak) -->
        <LinearLayout
            android:id="@+id/prayerTable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Subuh -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="0dp">
                <TextView
                    android:id="@+id/lblSubuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fajr"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeSubuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Syuruk -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblSyuruk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunrise"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeSyuruk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Zohor -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblZohor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dhuhr"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeZohor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Asar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblAsar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asr"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeAsar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maghrib"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Isyak -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblIsyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isha"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeIsyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/hud"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="18dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top bar: the menu buttons on the left, the system readout on the right. -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="-10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnAssistant"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Google Assistant"
                    android:drawableStart="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/btnCandyBox"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Candy Box"
                    android:drawableStart="@drawable/ic_candy_box" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings" />
            </LinearLayout>

            <!-- System readout: memory and free storage, refreshed with the clock while Home shows. -->
            <TextView
                android:id="@+id/sysReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/topButtons"
                android:layout_marginStart="16dp"
                android:gravity="end"
                android:focusable="false"
                android:includeFontPadding="false"
                android:textColor="#CCF3EFE6"
                android:textSize="12sp"
                android:fontFamily="@font/hud_bold"
                android:letterSpacing="0.24"
                android:textAllCaps="true"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Fallback Prayer Times view -->
            <TextView
                android:id="@+id/prayerTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/topButtons"
                android:layout_alignParentStart="true"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- The panels: wallpaper on the left, clock, weather and next prayer on the right. -->
        <LinearLayout
            android:id="@+id/panels"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- The wallpaper panel. The picture (and the weather effects over it) are added in code,
                 under the fade and the title; the ink line is the foreground, over all of them. -->
            <FrameLayout
                android:id="@+id/wallPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="700"
                android:background="#FF111111"
                android:foreground="@drawable/wall_panel_frame">

                <View
                    android:id="@+id/heroFade"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/hero_fade"
                    android:importantForAccessibility="no" />

                <!-- The picture's name: the episode line above, the title in Anton, a short line below. -->
                <LinearLayout
                    android:id="@+id/heroShelf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:layout_marginBottom="22dp"
                    android:orientation="vertical"
                    android:alpha="0">

                    <TextView
                        android:id="@+id/heroWhere"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textColor="#FFFF4B5C"
                        android:textSize="15sp"
                        android:fontFamily="@font/hud_bold"
                        android:letterSpacing="0.24"
                        android:textAllCaps="true"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/heroName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFF3EFE6"
                        android:textSize="46sp"
                        android:fontFamily="@font/display"
                        android:letterSpacing="0.01"
                        android:textAllCaps="true"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/heroDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#D9D8D2C4"
                        android:textSize="13sp"
                        android:fontFamily="@font/hud_regular"
                        android:lineSpacingExtra="2dp"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

            <LinearLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:focusable="false"
                android:visibility="gone"
                android:background="@drawable/glass_panel"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_media_app_pill"
                    android:src="@drawable/ic_music"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/cardTrackInfo" />

                <LinearLayout
                    android:id="@+id/cardTrackInfo"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_track_info_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/cardAlbumArt"
                    android:nextFocusRight="@+id/btnInlinePrev">

                    <TextView
                        android:id="@+id/cardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Now playing • SPOTIFY"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/hud"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.04"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Song Title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/hud"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />
                </LinearLayout>

                <!-- Inline Media Controls: Prev, Play/Pause, Next (Round buttons with ic_np_tint) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnInlinePrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/cardTrackInfo"
                        android:nextFocusRight="@+id/btnInlinePlayPause" />

                    <ImageView
                        android:id="@+id/btnInlinePlayPause"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pause"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePrev"
                        android:nextFocusRight="@+id/btnInlineNext" />

                    <ImageView
                        android:id="@+id/btnInlineNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePlayPause"
                        android:nextFocusRight="@+id/btnInlineClose" />

                    <ImageView
                        android:id="@+id/btnInlineClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlineNext" />
                </LinearLayout>
            </LinearLayout>
            </FrameLayout>

            <Space
                android:layout_width="24dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="476"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Clock card: cream paper, hard red shadow. -->
                <LinearLayout
                    android:id="@+id/leftBlock"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/clock_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="30dp"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:id="@+id/dateBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:textColor="#FF111111"
                            android:textSize="13sp"
                            android:fontFamily="@font/hud_bold"
                            android:letterSpacing="0.24"
                            android:textAllCaps="true"
                            android:singleLine="true" />

                        <!-- The weekday in Japanese (木曜日), on a red tag. -->
                        <TextView
                            android:id="@+id/dayKanji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/kanji_tag_bg"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="4dp"
                            android:includeFontPadding="false"
                            android:textColor="#FFFFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FF111111"
                            android:textSize="84sp"
                            android:fontFamily="@font/display"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:includeFontPadding="false"
                            android:textColor="#FF111111"
                            android:textSize="30sp"
                            android:fontFamily="@font/display"
                            android:textAllCaps="true" />

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#FF111111"
                            android:textSize="13sp"
                            android:fontFamily="@font/hud_medium"
                            android:includeFontPadding="false"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/stormzTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ストームズ"
                        android:visibility="gone" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:clipChildren="false">

                    <!-- Weather card: opens the weather screen. Filled in code (WEATHER, the temperature, the sky and the haze). -->
                    <TextView
                        android:id="@+id/weatherAirQuality"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/ink_card_bg"
                        android:gravity="top|start"
                        android:paddingStart="18dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="18dp"
                        android:includeFontPadding="false"
                        android:textColor="#FFF3EFE6"
                        android:textSize="14sp"
                        android:fontFamily="@font/hud_medium"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="4" />

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="match_parent" />

                    <!-- Next prayer card: OK opens today's prayer times and the daily verse. -->
                    <TextView
                        android:id="@+id/prayerCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/ink_card_bg"
                        android:gravity="top|start"
                        android:paddingStart="18dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="18dp"
                        android:includeFontPadding="false"
                        android:textColor="#FFF3EFE6"
                        android:textSize="13sp"
                        android:fontFamily="@font/hud_medium"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="5" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.syahmie.stormztv.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.syahmie.stormztv.FadeTopFrame>
    </LinearLayout>

    <!-- The single floating highlight that springs between tiles. -->
    <com.syahmie.stormztv.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
