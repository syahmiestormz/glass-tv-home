<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="660dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:padding="22dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_update"
            android:tint="#FFFFFFFF"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System updates"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/hud"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stormz TV • automatic updates"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/hud"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content: OTA controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Left Column: OTA Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_media_app_pill"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvAutoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Auto-update: on (03:30 AM)"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/hud"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Updates download and install in the background without interrupting what you watch."
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/hud"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Buttons -->
            <TextView
                android:id="@+id/btnCheckNow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_btn"
                android:text="🔄 Check for updates now"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/hud"
                android:textStyle="bold"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/btnChangeTime"
                android:nextFocusRight="@+id/btnClose"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btnChangeTime"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_btn"
                android:text="⏱️ Change auto-update time"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/hud"
                android:textStyle="bold"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnCheckNow"
                android:nextFocusDown="@+id/btnToggleAuto"
                android:nextFocusRight="@+id/btnClose"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btnToggleAuto"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_btn"
                android:text="⚡ Turn off auto-update"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/hud"
                android:textStyle="bold"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnChangeTime"
                android:nextFocusDown="@+id/btnClose"
                android:nextFocusRight="@+id/btnClose" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="130dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_dialog_btn"
            android:text="Close"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/hud"
            android:textStyle="bold"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/btnToggleAuto"
            android:nextFocusLeft="@+id/btnToggleAuto" />
    </LinearLayout>
</LinearLayout>
