<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF3DCB" />
            <stroke android:width="2dp" android:color="#FFFF3DCB" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFF3DCB" />
            <stroke android:width="1dp" android:color="#33FF3DCB" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
