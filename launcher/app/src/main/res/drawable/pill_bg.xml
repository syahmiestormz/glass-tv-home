<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for the top-bar pills; MainActivity swaps in GlassDrawable, which adds the blur.
     Flat glass: an even veil and a light rim, with no brighter top. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#9900040E" />
            <stroke android:width="1dp" android:color="#6600E5FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F00E5FF" />
            <stroke android:width="1dp" android:color="#4700E5FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
