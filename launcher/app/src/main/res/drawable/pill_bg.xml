<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback for the top-bar pills; MainActivity swaps in GlassDrawable, which adds the blur.
     Flat glass: an even veil and a light rim, with no brighter top. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#9907010E" />
            <stroke android:width="1dp" android:color="#66FF3DCB" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFF3DCB" />
            <stroke android:width="1dp" android:color="#47FF3DCB" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
