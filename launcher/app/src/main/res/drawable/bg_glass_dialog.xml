<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep obsidian frosted glass veil -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F00C0C10"
                android:centerColor="#E60C0C10"
                android:endColor="#E60A0A0D" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <!-- Subtle top sheen -->
    <item android:top="0dp" android:bottom="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00050507" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
