<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep obsidian frosted glass veil -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F008152C"
                android:centerColor="#E6091731"
                android:endColor="#E6061126" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#6600E5FF" />
        </shape>
    </item>
    <!-- Subtle top sheen -->
    <item android:top="0dp" android:bottom="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1F00E5FF"
                android:endColor="#0000040E" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
