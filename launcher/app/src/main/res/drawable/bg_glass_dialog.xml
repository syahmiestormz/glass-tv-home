<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep obsidian frosted glass veil -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F018072C"
                android:centerColor="#E61A0831"
                android:endColor="#E6140526" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#66FF3DCB" />
        </shape>
    </item>
    <!-- Subtle top sheen -->
    <item android:top="0dp" android:bottom="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1FFF3DCB"
                android:endColor="#0007010E" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp" />
        </shape>
    </item>
</layer-list>
