<?xml version="1.0" encoding="utf-8"?>
<!-- Wallpaper first: the picture stays untouched in the middle; black fades in at the top, behind the
     clock, and at the bottom, behind the dock, so text and tiles read on any wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|fill_horizontal" android:height="300dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D9000000"
                android:centerColor="#66000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="380dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F2000000"
                android:centerColor="#8C000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
