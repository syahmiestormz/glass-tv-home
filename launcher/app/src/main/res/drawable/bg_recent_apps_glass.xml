<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base smoky frosted glass gradient matching reference UI -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E6061126"
                android:centerColor="#D90C1E3D"
                android:endColor="#D93B567B" />
        </shape>
    </item>

    <!-- Center radial soft glow/sheen behind cards -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="850dp"
                android:centerX="50%"
                android:centerY="52%"
                android:startColor="#1F00E5FF"
                android:centerColor="#0800E5FF"
                android:endColor="#0000040E" />
        </shape>
    </item>

    <!-- Top dark vignette for crisp text contrast -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33030A19"
                android:endColor="#0000040E" />
        </shape>
    </item>
</layer-list>
