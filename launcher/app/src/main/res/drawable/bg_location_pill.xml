<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF00E5FF" />
            <stroke android:width="2dp" android:color="#FF00E5FF" />
            <corners android:radius="6dp" />
            <padding
                android:left="14dp"
                android:top="5dp"
                android:right="14dp"
                android:bottom="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2800E5FF" />
            <stroke android:width="1dp" android:color="#3500E5FF" />
            <corners android:radius="6dp" />
            <padding
                android:left="14dp"
                android:top="5dp"
                android:right="14dp"
                android:bottom="5dp" />
        </shape>
    </item>
</selector>
