<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#38030C1C"
                android:centerColor="#26071329"
                android:endColor="#38030C1C" />
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="#3300E5FF" />
        </shape>
    </item>
    <item android:bottom="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1A00E5FF"
                android:endColor="#0000040E" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp" />
        </shape>
    </item>
</layer-list>
