<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#380F041C"
                android:centerColor="#26160629"
                android:endColor="#380F041C" />
            <corners android:radius="10dp" />
            <stroke android:width="1.2dp" android:color="#33FF3DCB" />
        </shape>
    </item>
    <item android:bottom="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#1AFF3DCB"
                android:endColor="#0007010E" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp" />
        </shape>
    </item>
</layer-list>
